# ──────────────────────────────────────────────
# Portkey Configuration
# ──────────────────────────────────────────────

# Your Portkey API key (get from https://app.portkey.ai/settings)
PORTKEY_API_KEY=your_portkey_api_key_here

# ──────────────────────────────────────────────
# LLM Provider API Keys (direct provider auth)
# ──────────────────────────────────────────────
# Portkey routes your request to the provider you choose.
# Fill in the API key for each provider you plan to use.

OPENAI_API_KEY=sk-your_openai_api_key_here
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ──────────────────────────────────────────────
# Sync Configuration
# ──────────────────────────────────────────────

# How often (in seconds) the sync script polls Portkey for new prompts
SYNC_INTERVAL_SECONDS=60

# Path to prompts.json (relative to project root)
PROMPTS_FILE_PATH=prompts.json

# ──────────────────────────────────────────────
# Git Configuration (for auto-commit on sync)
# ──────────────────────────────────────────────
GIT_AUTO_COMMIT=false
GIT_REMOTE=origin
GIT_BRANCH=main

# ──────────────────────────────────────────────
# Windows command getting all the collections from portkey
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# Running the application
# ──────────────────────────────────────────────
# streamlit run streamlit_app.py
# python -m backend.sync_service
